{
  "name": "GhostShot Pro Design System",
  "version": "1.0.0",
  "color": {
    "brand": {
      "primary": "#6366F1",
      "primary-hover": "#4F46E5",
      "primary-subtle": "rgba(99, 102, 241, 0.12)",
