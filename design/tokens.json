      "gradient-end": "#06B6D4"
    },
    "neutral": {
      "bg-canvas": "#0F172A",
      "bg-surface": "#1E293B",
      "bg-elevated": "#334155",
      "bg-glass": "rgba(30, 41, 59, 0.75)",
      "border": "#334155",
      "border-light": "#475569",
      "text-primary": "#F8FAFC",
      "text-secondary": "#94A3B8",
      "text-muted": "#64748B"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "info": "#3B82F6"
    },
    "studio-palette": [
